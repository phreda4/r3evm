# Makefile for Windows (MinGW / Dev-C++ compatible)
CPP      = g++.exe
CC       = gcc.exe
WINDRES  = windres.exe
OBJ      = r3.o r3d.o
LIBS     = -static-libgcc -lmingw32 -lws2_32 -s -flto
INCS     = 
CXXINCS  = 
BIN      = r3.exe r3d.exe
CXXFLAGS = $(CXXINCS) -O2 -fpermissive -fomit-frame-pointer -fno-exceptions -fno-rtti
CFLAGS   = $(INCS) -O2
RM       = rm.exe -f

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	${RM} $(OBJ) $(BIN)

r3.exe: r3.o
	$(CPP) r3.o -o r3.exe $(LIBS)

r3d.exe: r3d.o
	$(CPP) r3d.o -o r3d.exe $(LIBS)

r3.o: r3.cpp
	$(CPP) -c r3.cpp -o r3.o $(CXXFLAGS)

r3d.o: r3d.cpp
	$(CPP) -c r3d.cpp -o r3d.o $(CXXFLAGS)