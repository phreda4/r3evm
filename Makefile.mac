# Makefile para Mac (optimizado para Apple Silicon y compatible con Intel)
CPP      = g++
CC       = gcc
OBJ      = r3.o r3d.o
LIBS     = -ldl -flto
BIN      = r3mac r3macd
CXXFLAGS = $(CXXINCS) -Oz -fpermissive -fomit-frame-pointer -fno-exceptions -fno-rtti
CFLAGS   = $(INCS) -Oz
RM       = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	${RM} $(OBJ) $(BIN)

r3mac: r3.o
	$(CPP) r3.o -o r3mac $(LIBS)

r3macd: r3d.o
	$(CPP) r3d.o -o r3macd $(LIBS)

r3.o: r3.cpp
	$(CPP) -c r3.cpp -o r3.o $(CXXFLAGS)

r3d.o: r3d.cpp
	$(CPP) -c r3d.cpp -o r3d.o $(CXXFLAGS)