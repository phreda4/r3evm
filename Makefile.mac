#
# Makefile for Mac (only tested with M2 Macair)
#
#
CPP      = g++
CC       = gcc
OBJ      = r3.o

LIBS     = -ldl -flto
BIN      = r3mac
CXXFLAGS = $(CXXINCS) -Oz -fpermissive -fomit-frame-pointer -fno-exceptions -fno-rtti
CFLAGS   = $(INCS) -Oz
RM       = rm -f

.PHONY: all all-before all-after clean clean-custom

all: $(BIN)

clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(OBJ) -o $(BIN) $(LIBS)

r3.o: r3.cpp
	$(CPP) -c r3.cpp -o r3.o $(CXXFLAGS)

r3d.o: r3d.cpp
	$(CPP) -c r3d.cpp -o r3d.o $(CXXFLAGS)